# Copy to .env and load it into your shell:  set -a; source .env; set +a
# Nothing reads this file by itself. On Replit these come from the workspace:
# DATABASE_URL from its database, SESSION_SECRET from Secrets, PORT from the
# artifact settings.

# The database the app runs on.
DATABASE_URL=postgres://scanner:scanner@localhost:5432/scanner_dev

# Signs the login cookie. Any long random string; required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# The API's port.
PORT=8080

# How many proxies sit in front of the API (Replit's edge is 1; 0 for none).
# The API takes the visitor's address (rate limits) and whether the request was
# HTTPS (the Secure cookie) from what the last of them adds. Optional.
# TRUST_PROXY_HOPS=1

# Logging level: trace, debug, info (default), warn, error or silent. Optional.
# LOG_LEVEL=info

# Only for the web dev server: where it sends /api (default http://127.0.0.1:8080,
# so change this if you changed PORT above). Optional.
# API_PROXY_TARGET=http://127.0.0.1:8080

# A SCRATCH database for tests. It is WIPED, and its name must contain "test".
# Never point this at real data.
TEST_DATABASE_URL=postgres://scanner:scanner@localhost:5432/scanner_test
