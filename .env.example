# Copy to .env and load it into your shell:  set -a; source .env; set +a
# Nothing reads this file by itself.

# The database the app runs on.
DATABASE_URL=postgres://scanner:scanner@localhost:5432/scanner_dev

# Signs the login cookie. Any long random string; required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# The API's port (the web dev server proxies /api to it).
PORT=8080

# A SCRATCH database for tests. It is wiped. Never point this at real data.
TEST_DATABASE_URL=postgres://scanner:scanner@localhost:5432/scanner_test
